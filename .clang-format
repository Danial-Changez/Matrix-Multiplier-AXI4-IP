# Applies to the hand-written C only (sw/matrix_multiplier/src/mm.c).
# platform.c/platform.h are AMD's hello_world template and the driver
# under vivado/ip_repo/ is generated by Vivado; neither is reformatted.
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
# Xilinx BSP headers are order-sensitive; keep the order as written.
SortIncludes: Never
