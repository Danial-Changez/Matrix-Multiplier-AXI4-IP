root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{vhd,yaml,yml,sh}]
indent_size = 2

[*.{c,h}]
indent_size = 4

# Vivado/Vitis write these files; leave them exactly as the tools emit them.
[{vivado/**,sw/matrix_multiplier/src/{platform.c,platform.h,lscript.ld,*.cmake,CMakeLists.txt}}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
